# ==============================================================================
# Project Babel — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files containing real secrets to version control.
# ==============================================================================

# Application Metadata & Runtime
APP_NAME="Project Babel"
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=true

# Server Network Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Docker Host Port Binding (Defaults to 5433 to avoid collision with native Windows PostgreSQL)
POSTGRES_PORT=5433

# PostgreSQL Database Connection Strings:
# 1. Internal Docker network connection string (used by backend container):
DATABASE_URL=postgresql+psycopg://babel_app:babel_dev_password@postgres:5432/babel_db

# 2. Local host connection string (used when running migrations or backend directly on host):
# DATABASE_URL=postgresql+psycopg://babel_app:babel_dev_password@127.0.0.1:5433/babel_db

# Dedicated PostgreSQL Container Initialization Credentials
POSTGRES_DB=babel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_root_password
APP_DB_USER=babel_app
APP_DB_PASSWORD=babel_dev_password

# Database Connection Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
